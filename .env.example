PORT=5000
NODE_ENV=development

# MongoDB connection string. Multi-document transactions (used by the booking
# workflow) require a replica set or MongoDB Atlas cluster - a standalone
# mongod instance will fail on prisma.$transaction calls.
# Example (Atlas): mongodb+srv://user:password@cluster0.mongodb.net/eventverse?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/eventverse?retryWrites=true&w=majority"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

CLIENT_URL="http://localhost:3000"

# Public token consumed by the React frontend (Mapbox GL JS + Search/Geocoding).
# Not used directly by the backend beyond documenting the contract; keep any
# server-side Mapbox secret token separate and never commit real values.
MAPBOX_ACCESS_TOKEN="pk.your_mapbox_public_token"

# Optional image/asset storage service
STORAGE_URL=""
STORAGE_KEY=""
STORAGE_SECRET=""

RATE_LIMIT_MAX=300
